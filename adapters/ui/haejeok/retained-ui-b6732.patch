diff --git a/src/lib/ChatScreens/uiContinuity.test.ts b/src/lib/ChatScreens/uiContinuity.test.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/ChatScreens/uiContinuity.test.ts
@@ -0,0 +1,48 @@
+import { afterEach, expect, test, vi } from 'vitest'
+import { mount, unmount, tick } from 'svelte'
+import Harness from './UiContinuityHarness.svelte'
+
+const { parse, pending } = vi.hoisted(() => {
+    const pending: ((value: string) => void)[] = []
+    return { pending, parse: vi.fn(() => new Promise<string>(resolve => pending.push(resolve))) }
+})
+vi.mock('src/ts/stores/domain/characterStore.svelte', () => ({ characterStore: {} }))
+vi.mock('src/ts/stores/domain', () => ({ settingsStore: { state: { newImageHandlingBeta: false } } }))
+vi.mock('src/ts/util', () => ({ sleep: async () => {} }))
+vi.mock('../../ts/alert', () => ({ alertError: vi.fn() }))
+vi.mock('../../ts/parser/parser.svelte', () => ({ ParseMarkdown: parse, trimMarkdown: (s: string) => s,
+    addMetadataToElement: (s: string) => s, postTranslationParse: (s: string) => s, getDistance: vi.fn() }))
+vi.mock('../../ts/translator/translator', () => ({ getLLMCache: vi.fn(), translateHTML: vi.fn() }))
+vi.mock('src/ts/chatAssetResolver', () => ({ resolveCurrentChatAsset: vi.fn() }))
+vi.mock('src/ts/globalApi.svelte', () => ({ getFileSrc: vi.fn() }))
+vi.mock('src/ts/mediaSrc', () => ({ isTauriAssetUrl: vi.fn() }))
+
+let app: { reload(value: string): void } | undefined
+afterEach(async () => { if (app) await unmount(app); app = undefined; pending.length = 0; parse.mockClear(); document.body.innerHTML = '' })
+async function settle() { await tick(); await Promise.resolve(); await tick() }
+
+test('retains the exact DOM while parsing and commits only the latest result', async () => {
+    const target = document.createElement('div'); document.body.append(target)
+    app = mount(Harness, { target }); await settle()
+    pending.shift()!('<div id="card">old</div>'); await settle()
+    const old = target.querySelector('#card')
+    expect(old?.textContent).toBe('old')
+    app.reload('second'); await settle()
+    expect(target.querySelector('#card')).toBe(old)
+    const stale = pending.shift()!
+    app.reload('third'); await settle()
+    const latest = pending.shift()!
+    latest('<div id="card">latest</div>'); await settle()
+    stale('<div id="card">stale</div>'); await settle()
+    expect(target.querySelector('#card')?.textContent).toBe('latest')
+})
+
+test('same rendered HTML does not remount existing effects', async () => {
+    const target = document.createElement('div'); document.body.append(target)
+    app = mount(Harness, { target }); await settle()
+    const html = '<div id="effect">particles</div>'
+    pending.shift()!(html); await settle()
+    const effect = target.querySelector('#effect')
+    app.reload('same-output'); await settle(); pending.shift()!(html); await settle()
+    expect(target.querySelector('#effect')).toBe(effect)
+})
