--- /dev/null
+++ b/packages/protocol/modelJobs.test.cjs
@@ -0,0 +1,254 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const {
+    canonicalizeJson,
+    fingerprintModelJobCreateRequest,
+    normalizeClientJobId,
+    sanitizePluginModelJobCreateRequest,
+    interpretModelJobGetResponse,
+    getBackgroundModelCapabilities,
+    publicPluginJobSnapshot,
+    toPluginJobSnapshot,
+    classifyRestartRunningJob,
+    resolveCancelCompletionRace,
+    validateResultAck,
+    principalCanAccessJob,
+    HOST_PRINCIPAL_ID,
+} = require('./modelJobs.cjs');
+
+test('canonical fingerprint includes URL query and credential epoch hashes, not secret plaintext', () => {
+    const base = {
+        targetUrl: 'https://api.example.com/v1/chat?key=super-secret',
+        targetOrigin: 'https://api.example.com/v1/chat',
+        method: 'POST',
+        headers: { Authorization: 'Bearer first-secret' },
+        body: '{"prompt":"hello"}',
+        chatId: 'chat-1',
+        generationId: 'gen-1',
+        protocol: 'openai',
+        model: 'gpt',
+        speakerId: null,
+        streaming: true,
+        recoverable: true,
+    };
+    const first = fingerprintModelJobCreateRequest(base);
+    const sameTimeout = fingerprintModelJobCreateRequest({
+        ...base,
+        timeoutMs: 12345,
+    });
+    const differentHeader = fingerprintModelJobCreateRequest({
+        ...base,
+        headers: { Authorization: 'Bearer other-secret' },
+    });
+    const differentQuery = fingerprintModelJobCreateRequest({
+        ...base,
+        targetUrl: 'https://api.example.com/v1/chat?key=other-secret',
+    });
+    const differentBody = fingerprintModelJobCreateRequest({
+        ...base,
+        body: '{"prompt":"other"}',
+    });
+    assert.equal(first, sameTimeout);
+    assert.equal(first.length, 64);
+    assert.notEqual(first, differentHeader);
+    assert.notEqual(first, differentQuery);
+    assert.notEqual(first, differentBody);
+    assert.equal(first.includes('super-secret'), false);
+    assert.equal(first.includes('first-secret'), false);
+    assert.notEqual(
+        first,
+        fingerprintModelJobCreateRequest({ ...base, kind: 'aux' }),
+    );
+});
+
+test('canonicalizeJson sorts keys', () => {
+    assert.equal(
+        JSON.stringify(canonicalizeJson({ b: 1, a: 2 })),
+        JSON.stringify({ a: 2, b: 1 }),
+    );
+});
+
+test('normalizeClientJobId accepts UUID values', () => {
+    const ok = normalizeClientJobId('11111111-1111-4111-8111-111111111111');
+    assert.equal(ok.value, '11111111-1111-4111-8111-111111111111');
+    const bad = normalizeClientJobId('not-a-uuid');
+    assert.equal(bad.httpStatus, 400);
+});
+
+test('plugin create sanitizer rejects arbitrary provider proxy fields', () => {
+    const result = sanitizePluginModelJobCreateRequest({
+        targetUrl: 'http://169.254.169.254/latest/meta-data/',
+        body: '{}',
+        chatId: 'chat-1',
+        headers: { Authorization: 'Bearer leaked' },
+        authorization: 'Bearer leaked',
+        'risu-auth': 'host-secret',
+        apiKey: 'test-live-key',
+    });
+    assert.equal(result.httpStatus, 405);
+    assert.match(result.error, /unavailable/i);
+    assert.equal(result.value, undefined);
+    assert.ok(result.stripped.includes('targetUrl'));
+    assert.ok(result.stripped.includes('headers'));
+    assert.ok(result.stripped.includes('body'));
+});
+
+test('configured plugin sanitizer accepts credentialRef and secret-free body only', () => {
+    const blocked = sanitizePluginModelJobCreateRequest({
+        credentialRef: 'provider-account://openai/default',
+        chatId: 'chat-1',
+        targetUrl: 'http://169.254.169.254/latest/meta-data/',
+        body: '{}',
+    }, { allowPluginJobCreation: true });
+    assert.equal(blocked.httpStatus, 400);
+    assert.ok(blocked.stripped.includes('targetUrl'));
+    const ok = sanitizePluginModelJobCreateRequest({
+        credentialRef: 'provider-account://openai/default',
+        chatId: 'chat-1',
+        body: '{"prompt":"hello"}',
+        kind: 'aux',
+    }, { allowPluginJobCreation: true });
+    assert.equal(ok.error, undefined);
+    assert.equal(ok.value.credentialRef, 'provider-account://openai/default');
+    assert.equal(ok.value.body, '{"prompt":"hello"}');
+    const leaked = sanitizePluginModelJobCreateRequest({
+        credentialRef: 'provider-account://openai/default',
+        chatId: 'chat-1',
+        body: '{"prompt":"Bearer test-live-key-1234567890123456"}',
+    }, { allowPluginJobCreation: true });
+    assert.equal(leaked.httpStatus, 400);
+});
+
+test('GET 404 never_created is not terminal missing', () => {
+    const missing = interpretModelJobGetResponse(404, {
+        error: 'Job not found',
+        missingReason: 'never_created',
+    });
+    assert.equal(missing.found, false);
+    assert.equal(missing.terminal, false);
+    assert.equal(missing.missingReason, 'never_created');
+
+    const found = interpretModelJobGetResponse(200, {
+        id: '11111111-1111-4111-8111-111111111111',
+        status: 'done',
+    });
+    assert.equal(found.found, true);
+    assert.equal(found.terminal, true);
+});
+
+test('host capabilities are honest about implemented seams', () => {
+    const caps = getBackgroundModelCapabilities();
+    assert.equal(caps.features.pluginJobCreation, false);
+    assert.equal(caps.features.tabCloseDurable, true);
+    assert.equal(caps.features.eventReplay, true);
+    assert.equal(caps.features.mainJobs, true);
+    assert.equal(caps.features.auxJobs, true);
+    assert.equal(caps.features.clientGeneratedJobIds, true);
+    assert.equal(caps.features.restartRecovery, true);
+    assert.equal(caps.features.toolWorkflows, false);
+    assert.equal(caps.features.deliveryLease, true);
+    assert.equal(caps.features.durableFinalization, true);
+    assert.equal(caps.features.serverProviders, false);
+    assert.equal(caps.adapter.target, 'haejeok');
+});
+
+test('plugin and server provider capabilities are true only when configured and tested', () => {
+    const untested = getBackgroundModelCapabilities({
+        providersConfigured: true,
+        providersTested: false,
+    });
+    assert.equal(untested.features.pluginJobCreation, false);
+    assert.equal(untested.features.serverProviders, false);
+    const ready = getBackgroundModelCapabilities({
+        providersConfigured: true,
+        providersTested: true,
+        providers: [{ credentialRef: 'provider-account://openai/default', protocol: 'openai', idempotent: true, allowedModels: null }],
+    });
+    assert.equal(ready.features.pluginJobCreation, true);
+    assert.equal(ready.features.serverProviders, true);
+    assert.equal(ready.features.toolWorkflows, false);
+});
+
+test('plugin snapshots omit source client ids and raw secrets', () => {
+    const snapshot = publicPluginJobSnapshot({
+        id: 'job-1',
+        chatId: 'chat-1',
+        status: 'running',
+        sourceClientId: 'client-session',
+        headers: { Authorization: 'Bearer x' },
+        'risu-auth': 'secret',
+    });
+    assert.equal(snapshot.id, 'job-1');
+    assert.equal('sourceClientId' in snapshot, false);
+    assert.equal('headers' in snapshot, false);
+    assert.equal('risu-auth' in snapshot, false);
+    assert.equal(snapshot.kind, 'main');
+    assert.equal(snapshot.principalId, HOST_PRINCIPAL_ID);
+});
+
+test('restart classification is ambiguous only after a possible send', () => {
+    const sent = classifyRestartRunningJob({ status: 'running', upstreamStatus: 200, bytes: 12 });
+    assert.equal(sent.status, 'ambiguous');
+    assert.equal(sent.retry, false);
+    const unsent = classifyRestartRunningJob({ status: 'running', upstreamStatus: null, bytes: 0 });
+    assert.equal(unsent.status, 'failed');
+    const unsentReconstructible = classifyRestartRunningJob(
+        { status: 'running', upstreamStatus: null, bytes: 0, executionEpoch: 1 },
+        { canReconstruct: true },
+    );
+    assert.equal(unsentReconstructible.retry, true);
+    assert.equal(unsentReconstructible.executionEpoch, 2);
+    const idempotentSent = classifyRestartRunningJob(
+        { status: 'running', upstreamStatus: 200, bytes: 4, executionEpoch: 3 },
+        { canReconstruct: true, idempotent: true },
+    );
+    assert.equal(idempotentSent.retry, true);
+    const revoked = classifyRestartRunningJob(
+        { status: 'running', upstreamStatus: null, bytes: 0 },
+        { canReconstruct: true, credentialStatus: 'blocked_credential', credentialReason: 'rotated' },
+    );
+    assert.equal(revoked.status, 'failed');
+    assert.match(revoked.error, /rotated|unavailable/i);
+});
+
+test('completion wins a cancel race after the upstream body finished', () => {
+    const completed = resolveCancelCompletionRace({
+        status: 'running',
+        abortRequested: true,
+        upstreamCompleted: true,
+    });
+    assert.equal(completed.status, 'done');
+    const aborted = resolveCancelCompletionRace({
+        status: 'running',
+        abortRequested: true,
+        upstreamCompleted: false,
+    });
+    assert.equal(aborted.status, 'aborted');
+});
+
+test('result ACK and principal scope helpers', () => {
+    const record = {
+        id: 'job-1',
+        status: 'done',
+        resultHash: 'a'.repeat(64),
+        ownerPrincipalId: 'plugin:alpha',
+    };
+    const ok = validateResultAck(record, 'A'.repeat(64), 'consumer-1');
+    assert.equal(ok.value.resultHash, 'a'.repeat(64));
+    const mismatch = validateResultAck(record, 'b'.repeat(64), 'consumer-1');
+    assert.equal(mismatch.conflict, 'resultHash');
+    assert.equal(principalCanAccessJob('plugin:alpha', record), true);
+    assert.equal(principalCanAccessJob('plugin:beta', record), false);
+    const snapshot = toPluginJobSnapshot({
+        ...record,
+        kind: 'aux',
+        generationId: 'gen-1',
+        createdAt: 1,
+        claimed: false,
+        deliveryState: 'undelivered',
+    });
+    assert.equal(snapshot.state, 'succeeded');
+    assert.equal(snapshot.kind, 'aux');
+});
