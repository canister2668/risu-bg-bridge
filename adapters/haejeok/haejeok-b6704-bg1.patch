+import {
+  getBackgroundModelCapabilities,
+  sanitizePluginModelJobCreateRequest,
+  toPluginJobSnapshot,
+  type BackgroundModelCapabilities,
+  type PluginJobSnapshot,
+  type ModelJobEvent,
+} from "../../../../packages/protocol/modelJobs.cjs";
+
+export interface BackgroundModelsHostOptions {
+  isNodeServer?: boolean;
+  principalId?: string;
+  clientId?: string;
+  fetchImpl?: typeof fetch;
+  getAuthHeaders?: () => Promise<Record<string, string>>;
+  requestPermission?: () => Promise<boolean>;
+  capabilities?: BackgroundModelCapabilities;
+}
+
+const PLUGIN_JOB_CREATE_UNAVAILABLE =
+  "Plugin background job creation is unavailable.";
+const PLUGIN_JOB_API_UNAVAILABLE =
+  "Plugin background job creation, lookup, cancel, and result APIs are unavailable.";
+
+export interface BackgroundJobListFilter {
+  state?: string;
+  kind?: "main" | "aux";
+  generationId?: string;
+  chatId?: string;
+  unclaimed?: boolean;
+  active?: boolean;
+}
+
+export interface BackgroundFinalizeRequest {
+  leaseId: string;
+  fencingToken: string;
+  materializationProof: {
+    messageId: string;
+    chatRevision?: number;
+    persistedAt?: string;
+    generationId?: string;
+  };
+}
+
+async function defaultAuthHeaders(principalId: string): Promise<Record<string, string>> {
+  const { getNodeServerProxyAuth } = await import("../../storage/files/nodeStorage");
+  const { getNodeClientSessionId } = await import("../../network/nodeClientSession");
+  return {
+    "risu-auth": await getNodeServerProxyAuth(),
+    "x-risu-client-id": getNodeClientSessionId(),
+    "x-risu-principal-id": principalId,
+  };
+}
+
+function jsonHeaders(base: Record<string, string>): Record<string, string> {
+  return { "content-type": "application/json", ...base };
+}
+
+async function readJson(response: Response): Promise<any> {
+  try {
+    return await response.json();
+  } catch {
+    return null;
+  }
+}
+
+export function createBackgroundModelsHost(
+  options: BackgroundModelsHostOptions = {},
+) {
+  const principalId = options.principalId || "plugin:anonymous";
+  const fetchImpl = options.fetchImpl ?? fetch.bind(globalThis);
+
+  const authHeaders = async () => {
+    if (options.getAuthHeaders) return options.getAuthHeaders();
+    return defaultAuthHeaders(principalId);
+  };
+
+  const ensurePermission = async () => {
+    if (!options.requestPermission) return true;
+    return options.requestPermission();
+  };
+
+  const unavailable = (extra: Record<string, unknown> = {}) => ({
+    error: PLUGIN_JOB_API_UNAVAILABLE,
+    httpStatus: 405,
+    ...extra,
+  });
+
+  async function hostFetch(path: string, init: RequestInit = {}) {
+    if (options.isNodeServer === false) {
+      return {
+        ok: false,
+        status: 405,
+        body: unavailable(),
+      };
+    }
+    const response = await fetchImpl(path, {
+      ...init,
+      headers: {
+        ...(await authHeaders()),
+        ...((init.headers as Record<string, string> | undefined) ?? {}),
+      },
+    });
+    return {
+      ok: response.ok,
+      status: response.status,
+      body: await readJson(response),
+    };
+  }
+
+  return {
+    async getCapabilities(): Promise<BackgroundModelCapabilities> {
+      if (options.capabilities) return options.capabilities;
+      if (options.isNodeServer === false) return getBackgroundModelCapabilities();
+      try {
+        const result = await hostFetch("/api/model-jobs/capabilities");
+        if (result.ok && result.body?.features) {
+          return result.body as BackgroundModelCapabilities;
+        }
+      } catch {
+        // Fall back to implementation-derived local defaults.
+      }
+      return getBackgroundModelCapabilities();
+    },
+
+    rejectUnsafeJobRequest(raw: unknown) {
+      return sanitizePluginModelJobCreateRequest(raw);
+    },
+
+    async createJob(raw: unknown) {
+      const preview = sanitizePluginModelJobCreateRequest(raw);
+      const hardBlocked = (preview.stripped || []).filter(
+        (key) => key !== "body" && key !== "payload",
+      );
+      if (hardBlocked.length > 0) {
+        return {
+          ...preview,
+          error: PLUGIN_JOB_CREATE_UNAVAILABLE,
+          httpStatus: 405,
+        };
+      }
+      const caps = await this.getCapabilities();
+      const sanitized = sanitizePluginModelJobCreateRequest(raw, {
+        allowPluginJobCreation: caps.features.pluginJobCreation === true,
+      });
+      if (sanitized.error || !sanitized.value) {
+        return {
+          ...sanitized,
+          error: sanitized.error || PLUGIN_JOB_CREATE_UNAVAILABLE,
+        };
+      }
+      if (!(await ensurePermission())) return unavailable({ stripped: [] });
+      const clientJobId = typeof sanitized.value.clientJobId === "string"
+        ? sanitized.value.clientJobId
+        : "";
+      const path = clientJobId
+        ? `/api/model-jobs/${encodeURIComponent(clientJobId)}`
+        : "/api/model-jobs";
+      const result = await hostFetch(path, {
+        method: clientJobId ? "PUT" : "POST",
+        headers: jsonHeaders({}),
+        body: JSON.stringify(sanitized.value),
+      });
+      if (!result.ok) {
+        return {
+          error: result.body?.error || PLUGIN_JOB_CREATE_UNAVAILABLE,
+          httpStatus: result.status || 405,
+          stripped: [],
+        };
+      }
+      return result.body;
+    },
+
+    async getJob(jobId: string): Promise<PluginJobSnapshot | { error: string; httpStatus: number }> {
+      if (!(await ensurePermission())) return unavailable();
+      const result = await hostFetch(`/api/model-jobs/${encodeURIComponent(jobId)}`);
+      if (!result.ok) {
+        return {
+          error: result.body?.error || "Job not found",
+          httpStatus: result.status || 404,
+        };
+      }
+      return toPluginJobSnapshot(result.body) || {
+        error: "Job not found",
+        httpStatus: 404,
+      };
+    },
+
+    async listJobs(filter: BackgroundJobListFilter = {}): Promise<PluginJobSnapshot[]> {
+      if (!(await ensurePermission())) return [];
+      const params = new URLSearchParams();
+      if (filter.active) params.set("active", "1");
+      else params.set("unclaimed", "1");
+      if (filter.kind) params.set("kind", filter.kind);
+      const result = await hostFetch(`/api/model-jobs?${params.toString()}`);
+      if (!result.ok || !Array.isArray(result.body?.jobs)) return [];
+      let jobs = result.body.jobs
+        .map((record: unknown) => toPluginJobSnapshot(record))
+        .filter(Boolean) as PluginJobSnapshot[];
+      if (filter.generationId) {
+        jobs = jobs.filter((job) => job.generationId === filter.generationId);
+      }
+      if (filter.chatId) {
+        jobs = jobs.filter((job) => (result.body.jobs as any[]).some((raw) => raw.id === job.jobId && raw.chatId === filter.chatId));
+      }
+      if (filter.state) {
+        jobs = jobs.filter((job) => job.state === filter.state);
+      }
+      return jobs;
+    },
+
+    async listEvents(
+      jobId: string,
+      opts: { afterSeq?: number } = {},
+    ): Promise<ModelJobEvent[]> {
+      if (!(await ensurePermission())) return [];
+      const after = Number(opts.afterSeq) || 0;
+      const result = await hostFetch(
+        `/api/model-jobs/${encodeURIComponent(jobId)}/events?after=${encodeURIComponent(String(after))}`,
+      );
+      if (!result.ok || !Array.isArray(result.body?.events)) return [];
+      return result.body.events as ModelJobEvent[];
+    },
+
+    async readResult(jobId: string) {
+      if (!(await ensurePermission())) return unavailable();
+      const result = await hostFetch(`/api/model-jobs/${encodeURIComponent(jobId)}/result`);
+      if (!result.ok) {
+        return {
+          error: result.body?.error || "Job result is unavailable",
+          httpStatus: result.status || 404,
+        };
+      }
+      return result.body;
+    },
+
+    async cancelJob(jobId: string, _reason?: string) {
+      if (!(await ensurePermission())) return unavailable();
+      const result = await hostFetch(`/api/model-jobs/${encodeURIComponent(jobId)}`, {
+        method: "DELETE",
+      });
+      if (!result.ok) {
+        return {
+          error: result.body?.error || "Job cancel failed",
+          httpStatus: result.status || 400,
+        };
+      }
+      return result.body;
+    },
+
+    async ackResult(jobId: string, consumerId: string, resultHash: string) {
+      if (!(await ensurePermission())) return unavailable();
+      const result = await hostFetch(`/api/model-jobs/${encodeURIComponent(jobId)}/result-ack`, {
+        method: "POST",
+        headers: jsonHeaders({}),
+        body: JSON.stringify({ consumerId, resultHash }),
+      });
+      if (!result.ok) {
+        return {
+          error: result.body?.error || "Result ACK failed",
+          httpStatus: result.status || 400,
+          conflict: result.body?.conflict,
+        };
+      }
+      return result.body;
+    },
+
+    async acquireDeliveryLease(jobId: string) {
+      if (!(await ensurePermission())) return unavailable();
+      const result = await hostFetch(`/api/model-jobs/${encodeURIComponent(jobId)}/delivery-lease`, {
+        method: "POST",
+      });
+      if (!result.ok) {
+        return {
+          error: result.body?.error || "Delivery lease failed",
+          httpStatus: result.status || 400,
+          conflict: result.body?.conflict,
+        };
+      }
+      return result.body;
+    },
+
+    async renewDeliveryLease(jobId: string, leaseId: string, fencingToken?: string) {
+      if (!(await ensurePermission())) return unavailable();
+      const result = await hostFetch(
+        `/api/model-jobs/${encodeURIComponent(jobId)}/delivery-lease/renew`,
+        {
+          method: "POST",
+          headers: jsonHeaders({}),
+          body: JSON.stringify({ leaseId, fencingToken }),
+        },
+      );
+      if (!result.ok) {
+        return {
+          error: result.body?.error || "Delivery lease renew failed",
+          httpStatus: result.status || 400,
+          conflict: result.body?.conflict,
+        };
+      }
+      return result.body;
+    },
+
+    async finalize(jobId: string, req: BackgroundFinalizeRequest) {
+      if (!(await ensurePermission())) return unavailable();
+      const result = await hostFetch(`/api/model-jobs/${encodeURIComponent(jobId)}/finalize`, {
+        method: "POST",
+        headers: jsonHeaders({}),
+        body: JSON.stringify(req),
+      });
+      if (!result.ok) {
+        return {
+          error: result.body?.error || "Finalize failed",
+          httpStatus: result.status || 400,
+          conflict: result.body?.conflict,
+        };
+      }
+      return result.body;
+    },
+  };
+}
+
+export function assertPluginJobApiUnavailable(): never {
+  throw new Error(PLUGIN_JOB_API_UNAVAILABLE);
+}
