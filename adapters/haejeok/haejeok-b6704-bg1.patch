+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("../storage/files/nodeStorage", () => ({
+  getNodeServerProxyAuth: vi.fn(async () => "host-secret"),
+}));
+vi.mock("./nodeClientSession", () => ({
+  getNodeClientSessionId: () => "client-1",
+}));
+
+import {
+  fetchViaDurableModelJob,
+  registerDurableGenerationContext,
+  unregisterDurableGenerationContext,
+  DurableModelJobBusyError,
+  DurableModelJobUnavailableError,
+} from "./durableModelJobs";
+
+const CLIENT_JOB_ID = "11111111-1111-4111-8111-111111111111";
+
+describe("fetchViaDurableModelJob", () => {
+  const fetches: Array<{ url: string; init?: RequestInit }> = [];
+
+  beforeEach(() => {
+    fetches.length = 0;
+    vi.spyOn(crypto, "randomUUID").mockReturnValue(CLIENT_JOB_ID);
+    registerDurableGenerationContext({
+      realChatId: "chat-1",
+      generationId: "gen-1",
+      model: "gpt",
+    });
+  });
+
+  afterEach(() => {
+    unregisterDurableGenerationContext("gen-1");
+    vi.restoreAllMocks();
+  });
+
+  function jsonResponse(status: number, body: unknown) {
+    return new Response(JSON.stringify(body), {
+      status,
+      headers: { "content-type": "application/json" },
+    });
+  }
+
+  it("creates jobs with PUT and client-generated ids", async () => {
+    vi.stubGlobal(
+      "fetch",
+      vi.fn(async (url: string, init?: RequestInit) => {
+        fetches.push({ url: String(url), init });
+        if (String(url).startsWith("/api/model-jobs/") && init?.method === "PUT") {
+          return jsonResponse(200, { jobId: CLIENT_JOB_ID, reused: false });
+        }
+        if (String(url).endsWith("/stream")) {
+          return new Response("hello", {
+            status: 200,
+            headers: {
+              "content-type": "text/plain",
+              "x-model-job-upstream-status": "200",
+            },
+          });
+        }
+        if (String(url) === `/api/model-jobs/${CLIENT_JOB_ID}`) {
+          return jsonResponse(200, { id: CLIENT_JOB_ID, status: "done" });
+        }
+        if (String(url).endsWith("/result")) {
+          return jsonResponse(200, { jobId: CLIENT_JOB_ID, resultHash: "a".repeat(64) });
+        }
+        if (String(url).endsWith("/result-ack") || String(url).endsWith("/claim")) {
+          return jsonResponse(200, { success: true });
+        }
+        throw new Error(`unexpected fetch ${url}`);
+      }),
+    );
+
+    const response = await fetchViaDurableModelJob("https://api.example.com/v1/chat", {
+      body: "{}",
+      generationId: "gen-1",
+    });
+    expect(response.status).toBe(200);
+    expect(fetches[0]?.url).toBe(`/api/model-jobs/${CLIENT_JOB_ID}`);
+    expect(fetches[0]?.init?.method).toBe("PUT");
+    const putBody = JSON.parse(String(fetches[0]?.init?.body));
+    expect(putBody.chatId).toBe("chat-1");
+    expect(putBody.kind).toBe("main");
+    expect(putBody.headers).toEqual({});
+    expect(fetches[0]?.init?.headers).toEqual(
+      expect.objectContaining({ "x-risu-principal-id": "host:internal" }),
+    );
+  });
+
+  it("falls back to POST when PUT is missing", async () => {
+    vi.stubGlobal(
+      "fetch",
+      vi.fn(async (url: string, init?: RequestInit) => {
+        fetches.push({ url: String(url), init });
+        if (init?.method === "PUT") return jsonResponse(404, { error: "no route" });
+        if (init?.method === "POST" && String(url) === "/api/model-jobs") {
+          return jsonResponse(200, { jobId: "server-id" });
+        }
+        if (String(url).endsWith("/stream")) {
+          return new Response("hello", {
+            status: 200,
+            headers: {
+              "content-type": "text/plain",
+              "x-model-job-upstream-status": "200",
+            },
+          });
+        }
+        if (String(url).includes("/api/model-jobs/server-id") && !String(url).includes("/stream") && !String(url).includes("/result")) {
+          return jsonResponse(200, { id: "server-id", status: "done" });
+        }
+        if (String(url).endsWith("/result")) {
+          return jsonResponse(200, { jobId: "server-id", resultHash: "a".repeat(64) });
+        }
+        if (String(url).endsWith("/result-ack") || String(url).endsWith("/claim")) {
+          return jsonResponse(200, { success: true });
+        }
+        throw new Error(`unexpected fetch ${url}`);
+      }),
+    );
+
+    const response = await fetchViaDurableModelJob("https://api.example.com/v1/chat", {
+      body: "{}",
+      generationId: "gen-1",
+    });
+    expect(response.status).toBe(200);
+    expect(fetches.some((item) => item.init?.method === "POST")).toBe(true);
+  });
+
+  it("does not treat pre-submit 404 as a terminal missing job", async () => {
+    vi.stubGlobal(
+      "fetch",
+      vi.fn(async (url: string, init?: RequestInit) => {
+        fetches.push({ url: String(url), init });
+        if (init?.method === "PUT") {
+          throw new TypeError("network down");
+        }
+        if (String(url) === `/api/model-jobs/${CLIENT_JOB_ID}` && !init?.method) {
+          return jsonResponse(404, {
+            error: "Job not found",
+            missingReason: "never_created",
+          });
+        }
+        throw new Error(`unexpected fetch ${url}`);
+      }),
+    );
+
+    await expect(
+      fetchViaDurableModelJob("https://api.example.com/v1/chat", {
+        body: "{}",
+        generationId: "gen-1",
+      }),
+    ).rejects.toThrow(/creation connection failed/);
+    expect(
+      fetches.some(
+        (item) =>
+          item.url === `/api/model-jobs/${CLIENT_JOB_ID}` && item.init?.method !== "PUT",
+      ),
+    ).toBe(true);
+  });
+
+  it("throws busy on chat conflict and unavailable when POST is also missing", async () => {
+    vi.stubGlobal(
+      "fetch",
+      vi.fn(async (_url: string, init?: RequestInit) => {
+        if (init?.method === "PUT") {
+          return jsonResponse(409, {
+            error: "A generation is already running for this chat",
+          });
+        }
+        throw new Error("unexpected");
+      }),
+    );
+    await expect(
+      fetchViaDurableModelJob("https://api.example.com/v1/chat", {
+        body: "{}",
+        generationId: "gen-1",
+      }),
+    ).rejects.toBeInstanceOf(DurableModelJobBusyError);
+
+    vi.stubGlobal(
+      "fetch",
+      vi.fn(async (_url: string, init?: RequestInit) => {
+        if (init?.method === "PUT" || init?.method === "POST") {
+          return jsonResponse(405, { error: "nope" });
+        }
+        throw new Error("unexpected");
+      }),
+    );
+    await expect(
+      fetchViaDurableModelJob("https://api.example.com/v1/chat", {
+        body: "{}",
+        generationId: "gen-1",
+      }),
+    ).rejects.toBeInstanceOf(DurableModelJobUnavailableError);
+  });
+});
