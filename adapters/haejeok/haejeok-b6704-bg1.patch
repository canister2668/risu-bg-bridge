+const CREDENTIAL_REF_PATTERN = /^provider-account:\/\/[A-Za-z0-9._-]+\/[A-Za-z0-9._-]+$/;
+const SECRET_ENV_PATTERN = /^[A-Z][A-Z0-9_]{1,127}$/;
+const BLOCKED_HOSTNAMES = new Set([
+    'localhost',
+    'metadata.google.internal',
+    'metadata.goog',
+    'instance-data',
+]);
+const SECRET_VALUE_PATTERNS = [
+    /\bBearer\s+[A-Za-z0-9\-._~+/]+=*/i,
+    /\bsk-[A-Za-z0-9]{16,}\b/,
+    /\bAIza[A-Za-z0-9_\-]{20,}\b/,
+    /\bya29\.[A-Za-z0-9_\-.]+\b/,
+    /\brisu-auth\s*[:=]\s*\S+/i,
+];
+
+function sha256Hex(value) {
+    return crypto.createHash('sha256').update(String(value)).digest('hex');
+}
+
+function asNonEmptyString(value, max = 500) {
+    if (typeof value !== 'string') return '';
+    const trimmed = value.trim();
+    return trimmed ? trimmed.slice(0, max) : '';
+}
+
+function ipv4ToInt(address) {
+    return address.split('.').reduce((acc, part) => (acc << 8) + Number(part), 0) >>> 0;
+}
+
+function ipv4InCidr(address, cidr, bits) {
+    const mask = bits === 0 ? 0 : (~0 << (32 - bits)) >>> 0;
+    return (ipv4ToInt(address) & mask) === (ipv4ToInt(cidr) & mask);
+}
+
+function isBlockedIpv4(address, { allowLoopback = false } = {}) {
+    if (ipv4InCidr(address, '0.0.0.0', 8)) return true;
+    if (ipv4InCidr(address, '10.0.0.0', 8)) return true;
+    if (ipv4InCidr(address, '100.64.0.0', 10)) return true;
+    if (ipv4InCidr(address, '127.0.0.0', 8)) return allowLoopback ? false : true;
+    if (ipv4InCidr(address, '169.254.0.0', 16)) return true;
+    if (ipv4InCidr(address, '172.16.0.0', 12)) return true;
+    if (ipv4InCidr(address, '192.168.0.0', 16)) return true;
+    if (ipv4InCidr(address, '198.18.0.0', 15)) return true;
+    return false;
+}
+
+function isBlockedIpv6(address, { allowLoopback = false } = {}) {
+    const normalized = address.toLowerCase();
+    if (normalized === '::' || normalized === '::0') return true;
+    if (normalized === '::1') return allowLoopback ? false : true;
+    if (normalized.startsWith('fc') || normalized.startsWith('fd')) return true;
+    if (normalized.startsWith('fe80:')) return true;
+    if (normalized.startsWith('::ffff:')) {
+        const mapped = normalized.slice('::ffff:'.length);
+        if (net.isIP(mapped) === 4) return isBlockedIpv4(mapped, { allowLoopback });
+    }
+    return false;
+}
+
+function isBlockedIpAddress(address, options = {}) {
+    const family = net.isIP(address);
+    if (family === 4) return isBlockedIpv4(address, options);
+    if (family === 6) return isBlockedIpv6(address, options);
+    return true;
+}
+
+function isBlockedHostname(hostname, { allowLoopback = false } = {}) {
+    const host = String(hostname || '').toLowerCase().replace(/\.$/, '');
+    if (!host) return true;
+    if (BLOCKED_HOSTNAMES.has(host) && !allowLoopback) return true;
+    if (host.endsWith('.localhost') && !allowLoopback) return true;
+    if (host.endsWith('.internal')) return true;
+    if (net.isIP(host)) return isBlockedIpAddress(host, { allowLoopback });
+    return false;
+}
+
+function validateProviderTargetUrl(rawUrl, { allowLoopback = false } = {}) {
+    let parsed;
+    try {
+        parsed = new URL(String(rawUrl || ''));
+    } catch {
+        return { error: 'Invalid provider URL', httpStatus: 400 };
+    }
+    if (!['http:', 'https:'].includes(parsed.protocol)) {
+        return { error: 'Provider URL must be http or https', httpStatus: 400 };
+    }
+    if (parsed.username || parsed.password) {
+        return { error: 'Provider URL must not contain credentials', httpStatus: 400 };
+    }
+    if (/[?&](key|token|secret|password|api[_-]?key)=/i.test(parsed.search)) {
+        return { error: 'Provider URL must not contain credential query parameters', httpStatus: 400 };
+    }
+    if (isBlockedHostname(parsed.hostname, { allowLoopback })) {
+        return { error: 'Provider URL is not an allowed public origin', httpStatus: 400 };
+    }
+    return { value: parsed.toString() };
+}
+
+function collectSecretStrings(value, out = []) {
+    if (typeof value === 'string') {
+        if (value.trim()) out.push(value);
+        return out;
+    }
+    if (Array.isArray(value)) {
+        for (const item of value) collectSecretStrings(item, out);
+        return out;
+    }
+    if (value && typeof value === 'object') {
+        for (const item of Object.values(value)) collectSecretStrings(item, out);
+    }
+    return out;
+}
+
+function scanForSecrets(value, knownSecrets = []) {
+    const found = [];
+    const haystack = typeof value === 'string' ? value : JSON.stringify(value || '');
+    for (const secret of knownSecrets) {
+        if (typeof secret === 'string' && secret && haystack.includes(secret)) {
+            found.push('known_secret');
+        }
+    }
+    for (const pattern of SECRET_VALUE_PATTERNS) {
+        if (pattern.test(haystack)) found.push(pattern.source);
+    }
+    return { found: [...new Set(found)], clean: found.length === 0 };
+}
+
+function normalizeCredentialRef(value) {
+    const ref = asNonEmptyString(value, 200);
+    if (!CREDENTIAL_REF_PATTERN.test(ref)) return '';
+    return ref;
+}
+
+function parseProviderEntry(raw, env = {}, { allowLoopback = false } = {}) {
+    if (!raw || typeof raw !== 'object' || Array.isArray(raw)) {
+        return { error: 'Invalid provider entry' };
+    }
+    const credentialRef = normalizeCredentialRef(raw.credentialRef || raw.id);
+    if (!credentialRef) return { error: 'Invalid credentialRef' };
+
+    const secretEnv = asNonEmptyString(raw.secretEnv || raw.auth?.valueEnv || raw.keyEnv, 128);
+    if (!SECRET_ENV_PATTERN.test(secretEnv)) {
+        return { error: `Provider ${credentialRef} must reference a secret via secretEnv` };
+    }
+    if (raw.secret || raw.apiKey || raw.token || raw.authorization || raw.auth?.value) {
+        return { error: `Provider ${credentialRef} must not embed secrets inline` };
+    }
+
+    const allowProviderLoopback = allowLoopback || raw.allowLoopback === true;
+    const urlResult = validateProviderTargetUrl(raw.targetUrl, { allowLoopback: allowProviderLoopback });
+    if (urlResult.error) {
+        return { error: `${credentialRef}: ${urlResult.error}` };
+    }
+
+    const secret = asNonEmptyString(env[secretEnv], 8192);
+    const blocked = raw.blocked === true || secret === '';
+    const headerName = asNonEmptyString(raw.headerName || raw.auth?.header, 64) || 'Authorization';
+    const headerPrefix = typeof (raw.headerPrefix ?? raw.auth?.prefix) === 'string'
+        ? raw.headerPrefix ?? raw.auth.prefix
+        : 'Bearer ';
+    const extraHeaders = {};
+    if (raw.headers && typeof raw.headers === 'object' && !Array.isArray(raw.headers)) {
+        for (const [key, value] of Object.entries(raw.headers)) {
+            if (typeof key !== 'string' || typeof value !== 'string') continue;
+            if (/authorization|cookie|api[_-]?key|secret|token|risu-auth/i.test(key)) {
+                return { error: `Provider ${credentialRef} extra headers cannot carry credentials` };
+            }
+            extraHeaders[key.toLowerCase()] = value;
+        }
+    }
+    const allowedModels = Array.isArray(raw.allowedModels)
+        ? raw.allowedModels.filter((item) => typeof item === 'string' && item.trim()).map((item) => item.slice(0, 160))
+        : null;
+    const epoch = asNonEmptyString(raw.epoch, 64) || (secret ? sha256Hex(secret).slice(0, 16) : 'missing');
+    return {
+        value: {
+            credentialRef,
+            targetUrl: urlResult.value,
+            protocol: asNonEmptyString(raw.protocol, 40) || 'unknown',
+            secretEnv,
+            headerName,
+            headerPrefix,
+            extraHeaders,
+            idempotent: raw.idempotent === true,
+            allowedModels,
+            allowLoopback: allowProviderLoopback,
+            blocked,
+            blockReason: blocked
+                ? (raw.blockReason || (secret ? 'Credential revoked' : `Missing environment secret ${secretEnv}`))
+                : null,
+            epoch,
+            tested: !blocked && Boolean(urlResult.value) && Boolean(secret),
+        },
+    };
+}
+
+function parseProviderRegistry(raw, env = {}, { allowLoopback = false } = {}) {
+    if (raw == null || raw === '') {
+        return { providers: [], configured: false, tested: false, error: null };
+    }
+    let parsed = raw;
+    if (typeof raw === 'string') {
+        try {
+            parsed = JSON.parse(raw);
+        } catch {
+            return { providers: [], configured: false, tested: false, error: 'Provider registry JSON is invalid' };
+        }
+    }
+    const list = Array.isArray(parsed)
+        ? parsed
+        : (Array.isArray(parsed?.providers) ? parsed.providers : null);
+    if (!list) {
+        return { providers: [], configured: false, tested: false, error: 'Provider registry must be an array' };
+    }
+    const providers = [];
+    for (const entry of list) {
+        const normalized = parseProviderEntry(entry, env, { allowLoopback });
+        if (normalized.error) {
+            return { providers: [], configured: false, tested: false, error: normalized.error };
+        }
+        if (providers.some((item) => item.credentialRef === normalized.value.credentialRef)) {
+            return {
+                providers: [],
+                configured: false,
+                tested: false,
+                error: `Duplicate credentialRef ${normalized.value.credentialRef}`,
+            };
+        }
+        providers.push(normalized.value);
+    }
+    const tested = providers.length > 0 && providers.some((item) => item.tested);
+    return {
+        providers,
+        configured: providers.length > 0,
+        tested,
+        error: null,
+    };
+}
+
+function loadProviderRegistryFromEnv(env = process.env, options = {}) {
+    const allowLoopback = options.allowLoopback === true
+        || env.RISU_BG_PROVIDER_ALLOW_LOOPBACK === '1'
+        || env.RISU_BG_PROVIDER_ALLOW_LOOPBACK === 'true';
+    let raw = env.RISU_BG_PROVIDER_REGISTRY;
+    const filePath = asNonEmptyString(env.RISU_BG_PROVIDER_REGISTRY_FILE, 1024);
+    if (!raw && filePath) {
+        try {
+            raw = fs.readFileSync(filePath, 'utf8');
+        } catch {
+            return {
+                providers: [],
+                configured: false,
+                tested: false,
+                error: 'Provider registry file could not be read',
+            };
+        }
+    }
+    return parseProviderRegistry(raw, env, { allowLoopback });
+}
+
+function publicProviderSnapshot(providers = []) {
+    return providers.filter((item) => item.tested).map((item) => ({
+        credentialRef: item.credentialRef,
+        protocol: item.protocol,
+        idempotent: item.idempotent === true,
+        allowedModels: item.allowedModels,
+    }));
+}
+
+function resolveProviderCredential(providers, credentialRef, expectedEpoch) {
+    const ref = normalizeCredentialRef(credentialRef);
+    if (!ref) {
+        return {
+            status: 'failed_credential',
+            credentialRef: String(credentialRef || ''),
+            reason: 'Invalid credentialRef',
+        };
+    }
+    const provider = (providers || []).find((item) => item.credentialRef === ref);
+    if (!provider) {
+        return {
+            status: 'failed_credential',
+            credentialRef: ref,
+            reason: `CredentialNotFound: No approved provider for '${ref}'`,
+        };
+    }
+    if (provider.blocked || !provider.tested) {
+        return {
+            status: 'blocked_credential',
+            credentialRef: ref,
+            reason: provider.blockReason || `CredentialBlocked: '${ref}' is disabled`,
+        };
+    }
+    if (expectedEpoch != null && expectedEpoch !== '' && expectedEpoch !== provider.epoch) {
+        return {
+            status: 'blocked_credential',
+            credentialRef: ref,
+            reason: `CredentialEpochMismatch: Expected epoch '${expectedEpoch}', current is '${provider.epoch}'`,
+        };
+    }
+    return {
+        status: 'resolved',
+        credentialRef: ref,
+        credentialEpoch: provider.epoch,
+        targetUrl: provider.targetUrl,
+        protocol: provider.protocol,
+        idempotent: provider.idempotent === true,
+        allowedModels: provider.allowedModels,
+        allowLoopback: provider.allowLoopback === true,
+        headerName: provider.headerName,
+        headerPrefix: provider.headerPrefix,
+        extraHeaders: provider.extraHeaders,
+        secretEnv: provider.secretEnv,
+    };
+}
+
+function materializeResolvedHeaders(provider, secret) {
+    const headers = { ...provider.extraHeaders };
+    headers[provider.headerName.toLowerCase()] = `${provider.headerPrefix}${secret}`;
+    return headers;
+}
+
+function knownSecretsFromEnv(providers, env = {}) {
+    const secrets = [];
+    for (const provider of providers || []) {
+        const secret = asNonEmptyString(env[provider.secretEnv], 8192);
+        if (secret) secrets.push(secret);
+    }
+    return secrets;
+}
+
+function reconstructibleRequestEnvelope(request, fingerprint) {
+    return {
+        targetOrigin: request?.targetOrigin ?? null,
+        method: request?.method ?? 'POST',
+        chatId: request?.chatId ?? '',
+        generationId: request?.generationId ?? null,
+        protocol: request?.protocol ?? 'unknown',
+        model: request?.model ?? null,
+        speakerId: request?.speakerId ?? null,
+        streaming: request?.streaming === true,
+        recoverable: request?.recoverable !== false,
+        kind: request?.kind === 'aux' ? 'aux' : 'main',
+        timeoutMs: request?.timeoutMs,
+        credentialRef: request?.credentialRef || null,
+        credentialEpoch: request?.credentialEpoch || null,
+        requestFingerprint: fingerprint || null,
+        requestEnvelopeRef: fingerprint ? `envelope://${fingerprint}` : null,
+        body: typeof request?.body === 'string' ? request.body : '',
+        idempotent: request?.idempotent === true,
+        executionEpoch: Number(request?.executionEpoch || 1),
+    };
+}
+
+async function assertResolvedAddressesSafe(targetUrl, lookup, { allowLoopback = false } = {}) {
+    const urlResult = validateProviderTargetUrl(targetUrl, { allowLoopback });
+    if (urlResult.error) return urlResult;
+    const hostname = new URL(urlResult.value).hostname;
+    if (net.isIP(hostname)) {
+        if (isBlockedIpAddress(hostname, { allowLoopback })) {
+            return { error: 'Provider URL is not an allowed public origin', httpStatus: 400 };
+        }
+        return { value: urlResult.value };
+    }
+    if (typeof lookup !== 'function') return { value: urlResult.value };
+    let addresses;
+    try {
+        addresses = await lookup(hostname);
+    } catch {
+        return { error: 'Provider URL hostname could not be resolved', httpStatus: 400 };
+    }
+    const list = Array.isArray(addresses) ? addresses : [addresses];
+    for (const entry of list) {
+        const address = typeof entry === 'string' ? entry : entry?.address;
+        if (!address || isBlockedIpAddress(address, { allowLoopback })) {
+            return { error: 'Provider URL resolves to a blocked address', httpStatus: 400 };
+        }
+    }
+    return { value: urlResult.value };
+}
+
+module.exports = {
+    CREDENTIAL_REF_PATTERN,
+    validateProviderTargetUrl,
+    isBlockedIpAddress,
+    isBlockedHostname,
+    scanForSecrets,
+    collectSecretStrings,
+    parseProviderRegistry,
+    loadProviderRegistryFromEnv,
+    publicProviderSnapshot,
+    resolveProviderCredential,
+    materializeResolvedHeaders,
+    knownSecretsFromEnv,
+    reconstructibleRequestEnvelope,
+    assertResolvedAddressesSafe,
+    normalizeCredentialRef,
+};
diff --git a/packages/protocol/providerRegistry.d.cts b/packages/protocol/providerRegistry.d.cts
new file mode 100644
index 00000000..30b7589e
--- /dev/null
+++ b/packages/protocol/providerRegistry.d.cts
@@ -0,0 +1,121 @@
+export const CREDENTIAL_REF_PATTERN: RegExp;
+
+export interface ProviderRegistryEntry {
+  credentialRef: string;
+  targetUrl: string;
+  protocol: string;
+  secretEnv: string;
+  headerName: string;
+  headerPrefix: string;
+  extraHeaders: Record<string, string>;
+  idempotent: boolean;
+  allowedModels: string[] | null;
+  allowLoopback: boolean;
+  blocked: boolean;
+  blockReason: string | null;
+  epoch: string;
+  tested: boolean;
+}
+
+export interface ProviderRegistrySnapshot {
+  providers: ProviderRegistryEntry[];
+  configured: boolean;
+  tested: boolean;
+  error: string | null;
+}
+
+export interface PublicProviderSnapshot {
+  credentialRef: string;
+  protocol: string;
+  idempotent: boolean;
+  allowedModels: string[] | null;
+}
+
+export type ProviderCredentialResolution =
+  | {
+      status: 'resolved';
+      credentialRef: string;
+      credentialEpoch: string;
+      targetUrl: string;
+      protocol: string;
+      idempotent: boolean;
+      allowedModels: string[] | null;
+      allowLoopback: boolean;
+      headerName: string;
+      headerPrefix: string;
+      extraHeaders: Record<string, string>;
+      secretEnv: string;
+    }
+  | {
+      status: 'blocked_credential' | 'failed_credential';
+      credentialRef: string;
+      reason: string;
+    };
+
+export function validateProviderTargetUrl(
+  rawUrl: unknown,
+  options?: { allowLoopback?: boolean },
+): { value: string; error?: never; httpStatus?: never } | { value?: never; error: string; httpStatus: number };
+
+export function isBlockedIpAddress(
+  address: string,
+  options?: { allowLoopback?: boolean },
+): boolean;
+
+export function isBlockedHostname(
+  hostname: string,
+  options?: { allowLoopback?: boolean },
+): boolean;
+
+export function scanForSecrets(
+  value: unknown,
+  knownSecrets?: string[],
+): { found: string[]; clean: boolean };
+
+export function collectSecretStrings(value: unknown, out?: string[]): string[];
+
+export function parseProviderRegistry(
+  raw: unknown,
+  env?: Record<string, string | undefined>,
+  options?: { allowLoopback?: boolean },
+): ProviderRegistrySnapshot;
+
+export function loadProviderRegistryFromEnv(
+  env?: Record<string, string | undefined>,
+  options?: { allowLoopback?: boolean },
+): ProviderRegistrySnapshot;
+
+export function publicProviderSnapshot(
+  providers?: ProviderRegistryEntry[],
+): PublicProviderSnapshot[];
+
+export function resolveProviderCredential(
+  providers: ProviderRegistryEntry[] | undefined,
+  credentialRef: unknown,
+  expectedEpoch?: string | null,
+): ProviderCredentialResolution;
+
+export function materializeResolvedHeaders(
+  provider: Pick<ProviderRegistryEntry, 'extraHeaders' | 'headerName' | 'headerPrefix'>,
+  secret: string,
+): Record<string, string>;
+
+export function knownSecretsFromEnv(
+  providers: ProviderRegistryEntry[] | undefined,
+  env?: Record<string, string | undefined>,
+): string[];
+
+export function reconstructibleRequestEnvelope(
+  request: Record<string, unknown> | null | undefined,
+  fingerprint?: string | null,
+): Record<string, unknown>;
+
+export function assertResolvedAddressesSafe(
+  targetUrl: string,
+  lookup?: ((hostname: string) => Promise<unknown>) | null,
+  options?: { allowLoopback?: boolean },
+): Promise<
+  { value: string; error?: never; httpStatus?: never } | { value?: never; error: string; httpStatus: number }
+>;
+
+export function normalizeCredentialRef(value: unknown): string;
diff --git a/packages/protocol/providerRegistry.test.cjs b/packages/protocol/providerRegistry.test.cjs
