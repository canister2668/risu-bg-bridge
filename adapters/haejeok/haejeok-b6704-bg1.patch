index 00000000..32a844a9
--- /dev/null
+++ b/packages/protocol/providerRegistry.test.cjs
@@ -0,0 +1,91 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const {
+    parseProviderRegistry,
+    validateProviderTargetUrl,
+    scanForSecrets,
+    resolveProviderCredential,
+    reconstructibleRequestEnvelope,
+} = require('./providerRegistry.cjs');
+
+const OPENAI_REF = 'provider-account://openai/default';
+
+function registryJson(overrides = {}) {
+    return [{
+        credentialRef: OPENAI_REF,
+        targetUrl: 'https://api.openai.com/v1/chat/completions',
+        protocol: 'openai',
+        secretEnv: 'OPENAI_API_KEY',
+        idempotent: true,
+        ...overrides,
+    }];
+}
+
+test('unconfigured registry does not enable providers', () => {
+    const empty = parseProviderRegistry('', {});
+    assert.equal(empty.configured, false);
+    assert.equal(empty.tested, false);
+    const missingSecret = parseProviderRegistry(registryJson(), {});
+    assert.equal(missingSecret.configured, true);
+    assert.equal(missingSecret.tested, false);
+    assert.equal(missingSecret.providers[0].tested, false);
+});
+
+test('configured registry is tested only when the env secret is present', () => {
+    const ready = parseProviderRegistry(registryJson(), { OPENAI_API_KEY: 'test-live-not-for-disk' });
+    assert.equal(ready.configured, true);
+    assert.equal(ready.tested, true);
+    assert.equal(ready.providers[0].tested, true);
+    assert.equal(JSON.stringify(ready).includes('test-live-not-for-disk'), false);
+});
+
+test('inline secrets and credential query URLs are rejected', () => {
+    const inline = parseProviderRegistry([{
+        credentialRef: OPENAI_REF,
+        targetUrl: 'https://api.openai.com/v1/chat/completions',
+        secretEnv: 'OPENAI_API_KEY',
+        apiKey: 'sk-inline',
+    }], { OPENAI_API_KEY: 'sk-env' });
+    assert.match(inline.error, /embed secrets/i);
+    const query = validateProviderTargetUrl('https://api.openai.com/v1/chat?api_key=secret');
+    assert.equal(query.httpStatus, 400);
+    const metadata = validateProviderTargetUrl('http://169.254.169.254/latest/meta-data/');
+    assert.equal(metadata.httpStatus, 400);
+    const loopback = validateProviderTargetUrl('http://127.0.0.1/v1/chat');
+    assert.equal(loopback.httpStatus, 400);
+    const allowed = validateProviderTargetUrl('http://127.0.0.1/v1/chat', { allowLoopback: true });
+    assert.ok(allowed.value);
+});
+
+test('credential rotation and revocation fail closed', () => {
+    const first = parseProviderRegistry(registryJson(), { OPENAI_API_KEY: 'test-old-key' });
+    const epoch = first.providers[0].epoch;
+    const rotated = parseProviderRegistry(registryJson(), { OPENAI_API_KEY: 'test-new-key' });
+    const mismatch = resolveProviderCredential(rotated.providers, OPENAI_REF, epoch);
+    assert.equal(mismatch.status, 'blocked_credential');
+    assert.match(mismatch.reason, /EpochMismatch/i);
+    const revoked = parseProviderRegistry(registryJson({ blocked: true }), { OPENAI_API_KEY: 'test-new-key' });
+    const blocked = resolveProviderCredential(revoked.providers, OPENAI_REF, rotated.providers[0].epoch);
+    assert.equal(blocked.status, 'blocked_credential');
+    const missing = resolveProviderCredential(first.providers, 'provider-account://openai/other');
+    assert.equal(missing.status, 'failed_credential');
+});
+
+test('secret scanner and reconstructible envelopes omit credentials', () => {
+    const leaked = scanForSecrets({ body: 'Authorization: Bearer test-live-key-1234567890123456' }, ['test-live-key-1234567890123456']);
+    assert.equal(leaked.clean, false);
+    const envelope = reconstructibleRequestEnvelope({
+        chatId: 'chat-1',
+        body: '{"prompt":"hello"}',
+        credentialRef: OPENAI_REF,
+        headers: { Authorization: 'Bearer test-live-key' },
+        targetUrl: 'https://api.openai.com/v1/chat/completions?key=test-live-key',
+    }, 'abc');
+    assert.equal(envelope.body, '{"prompt":"hello"}');
+    assert.equal(envelope.credentialRef, OPENAI_REF);
+    assert.equal('headers' in envelope, false);
+    assert.equal('targetUrl' in envelope, false);
+    assert.equal(JSON.stringify(envelope).includes('test-live-key'), false);
