+import { describe, expect, it, vi } from "vitest";
+import {
+  assertPluginJobApiUnavailable,
+  createBackgroundModelsHost,
+} from "./backgroundModels";
+
+describe("backgroundModels host bridge", () => {
+  it("reports honest host capabilities and keeps plugin creation closed", async () => {
+    const host = createBackgroundModelsHost({
+      isNodeServer: true,
+      fetchImpl: vi.fn(async () => {
+        throw new Error("offline");
+      }) as unknown as typeof fetch,
+      getAuthHeaders: async () => ({}),
+    });
+    const caps = await host.getCapabilities();
+    expect(caps.features.pluginJobCreation).toBe(false);
+    expect(caps.features.tabCloseDurable).toBe(true);
+    expect(caps.features.eventReplay).toBe(true);
+    expect(caps.features.mainJobs).toBe(true);
+    expect(caps.features.auxJobs).toBe(true);
+    expect(caps.features.clientGeneratedJobIds).toBe(true);
+    expect(caps.features.restartRecovery).toBe(true);
+    expect(caps.features.toolWorkflows).toBe(false);
+    expect(caps.features.deliveryLease).toBe(true);
+    expect(caps.features.durableFinalization).toBe(true);
+    expect(typeof host.createJob).toBe("function");
+    expect(typeof host.getJob).toBe("function");
+    expect(typeof host.cancelJob).toBe("function");
+    expect(typeof host.readResult).toBe("function");
+  });
+
+  it("rejects arbitrary targetUrl/body/credential plugin proxy requests", async () => {
+    const fetchImpl = vi.fn();
+    const host = createBackgroundModelsHost({
+      isNodeServer: true,
+      fetchImpl: fetchImpl as unknown as typeof fetch,
+    });
+    const rejected = host.rejectUnsafeJobRequest({
+      targetUrl: "http://169.254.169.254/latest/meta-data/",
+      body: '{"prompt":"x"}',
+      headers: { Authorization: "Bearer plugin-secret" },
+      chatId: "chat-1",
+    });
+    expect(rejected.httpStatus).toBe(405);
+    expect(rejected.error).toMatch(/unavailable/i);
+    expect(rejected.stripped).toEqual(
+      expect.arrayContaining(["targetUrl", "body", "headers"]),
+    );
+    const created = await host.createJob({
+      targetUrl: "https://example.internal/admin",
+      body: "{}",
+      chatId: "chat-1",
+    });
+    expect(created.httpStatus).toBe(405);
+    expect(fetchImpl).not.toHaveBeenCalled();
+  });
+
+  it("scopes authenticated get/list/event/result/ack/lease calls to the plugin principal", async () => {
+    const fetchImpl = vi.fn(async (url: string, init?: RequestInit) => {
+      const headers = init?.headers as Record<string, string>;
+      expect(headers["risu-auth"]).toBe("host-secret");
+      expect(headers["x-risu-principal-id"]).toBe("plugin:alpha");
+      if (String(url).includes("/events")) {
+        return new Response(
+          JSON.stringify({
+            events: [
+              {
+                jobId: "job-1",
+                seq: 1,
+                eventId: "evt-1",
+                type: "result_ready",
+                createdAt: new Date().toISOString(),
+                payload: { resultHash: "a".repeat(64) },
+              },
+            ],
+          }),
+          { status: 200, headers: { "content-type": "application/json" } },
+        );
+      }
+      if (String(url).includes("/result-ack") || String(url).includes("/delivery-lease")) {
+        return new Response(JSON.stringify({ success: true, leaseId: "lease-1", fencingToken: "1" }), {
+          status: 200,
+          headers: { "content-type": "application/json" },
+        });
+      }
+      if (String(url).includes("/result")) {
+        return new Response(
+          JSON.stringify({
+            jobId: "job-1",
+            status: "done",
+            resultHash: "a".repeat(64),
+            kind: "aux",
+          }),
+          { status: 200, headers: { "content-type": "application/json" } },
+        );
+      }
+      if (String(url) === "/api/model-jobs?unclaimed=1&kind=aux") {
+        return new Response(
+          JSON.stringify({
+            jobs: [
+              {
+                id: "job-1",
+                status: "done",
+                kind: "aux",
+                generationId: "gen-1",
+                chatId: "chat-1",
+                createdAt: Date.now(),
+                requestFingerprint: "f".repeat(64),
+                claimed: false,
+              },
+            ],
+          }),
+          { status: 200, headers: { "content-type": "application/json" } },
+        );
+      }
+      if (String(url).startsWith("/api/model-jobs/job-1")) {
+        return new Response(
+          JSON.stringify({
+            id: "job-1",
+            status: "done",
+            kind: "aux",
+            generationId: "gen-1",
+            createdAt: Date.now(),
+            requestFingerprint: "f".repeat(64),
+            claimed: false,
+          }),
+          { status: 200, headers: { "content-type": "application/json" } },
+        );
+      }
+      throw new Error(`unexpected ${url}`);
+    });
+
+    const host = createBackgroundModelsHost({
+      isNodeServer: true,
+      principalId: "plugin:alpha",
+      fetchImpl: fetchImpl as unknown as typeof fetch,
+      getAuthHeaders: async () => ({
+        "risu-auth": "host-secret",
+        "x-risu-principal-id": "plugin:alpha",
+      }),
+    });
+
+    const listed = await host.listJobs({ kind: "aux" });
+    expect(listed[0]?.jobId).toBe("job-1");
+    expect(listed[0]?.kind).toBe("aux");
+    const job = await host.getJob("job-1");
+    expect("jobId" in job && job.jobId).toBe("job-1");
+    const events = await host.listEvents("job-1", { afterSeq: 0 });
+    expect(events[0]?.type).toBe("result_ready");
+    const result = await host.readResult("job-1");
+    expect(result.resultHash).toBe("a".repeat(64));
+    await host.ackResult("job-1", "plugin:alpha", "a".repeat(64));
+    await host.acquireDeliveryLease("job-1");
+    expect(fetchImpl).toHaveBeenCalled();
+  });
+
+  it("does not expose a plugin path that forwards secrets to the model-jobs proxy", async () => {
+    const fetchImpl = vi.fn();
+    const host = createBackgroundModelsHost({
+      isNodeServer: true,
+      fetchImpl: fetchImpl as unknown as typeof fetch,
+    });
+    await host.createJob({
+      targetUrl: "https://example.internal/admin",
+      body: "{}",
+      chatId: "chat-1",
+      authorization: "Bearer leaked",
+    });
+    expect(fetchImpl).not.toHaveBeenCalled();
+    expect(() => assertPluginJobApiUnavailable()).toThrow(/unavailable/i);
+  });
+
+  it("creates approved jobs only when serverProviders are configured", async () => {
+    const fetchImpl = vi.fn(async (url: string, init?: RequestInit) => {
+      if (String(url).endsWith("/capabilities")) {
+        return new Response(
+          JSON.stringify({
+            contractVersion: 1,
+            features: {
+              pluginJobCreation: true,
+              tabCloseDurable: true,
+              restartRecovery: true,
+              eventReplay: true,
+              mainJobs: true,
+              auxJobs: true,
+              toolWorkflows: false,
+              deliveryLease: true,
+              durableFinalization: true,
+              serverProviders: true,
+              browserProviderPersistence: false,
+              clientGeneratedJobIds: true,
+            },
+            pipelineVersion: "risu-finalize/1",
+            adapter: { target: "haejeok", version: "b6704+bg1" },
+          }),
+          { status: 200, headers: { "content-type": "application/json" } },
+        );
+      }
+      if (String(url) === "/api/model-jobs/11111111-1111-4111-8111-111111111111" && init?.method === "PUT") {
+        const body = JSON.parse(String(init.body));
+        expect(body.targetUrl).toBeUndefined();
+        expect(body.headers).toBeUndefined();
+        expect(body.credentialRef).toBe("provider-account://openai/default");
+        return new Response(JSON.stringify({ jobId: "job-created" }), {
+          status: 200,
+          headers: { "content-type": "application/json" },
+        });
+      }
+      throw new Error(`unexpected ${url}`);
+    });
+    const host = createBackgroundModelsHost({
+      isNodeServer: true,
+      fetchImpl: fetchImpl as unknown as typeof fetch,
+      getAuthHeaders: async () => ({ "risu-auth": "host-secret" }),
+    });
+    const created = await host.createJob({
+      clientJobId: "11111111-1111-4111-8111-111111111111",
+      credentialRef: "provider-account://openai/default",
+      chatId: "chat-1",
+      generationId: "gen-1",
+      kind: "aux",
+      body: '{"messages":[{"role":"user","content":"hi"}]}',
+    });
+    expect(created).toEqual({ jobId: "job-created" });
+    expect(fetchImpl).toHaveBeenCalled();
+  });
+});
